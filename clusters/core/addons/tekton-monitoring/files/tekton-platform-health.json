{
  "uid": "tekton-platform-health",
  "title": "Tekton / Platform Health",
  "tags": [
    "tekton",
    "krci"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Scrape targets",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"tekton-.*|el-.*|.*results.*\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "container": true,
              "service": true,
              "pod": true,
              "eventlistener": true
            },
            "renameByName": {
              "Value": "Up",
              "job": "job",
              "namespace": "namespace"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Up",
            "desc": true
          }
        ]
      },
      "description": "Prometheus scrape state per component. Any DOWN means blind spots in every other dashboard."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reconcile latency p95 by reconciler",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, label_replace(sum by (reconciler, le) (rate(tekton_pipelines_controller_reconcile_latency_bucket[$__rate_interval])), \"reconciler\", \"$1\", \"reconciler\", \".*\\\\.([^.]+)\\\\.Reconciler\"))",
          "legendFormat": "{{reconciler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Controller reconcile duration p95. Rising = controller falling behind."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reconcile outcomes per interval",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (reconciler, success) (rate(tekton_pipelines_controller_reconcile_count[$__rate_interval])), \"reconciler\", \"$1\", \"reconciler\", \".*\\\\.([^.]+)\\\\.Reconciler\")",
          "legendFormat": "{{reconciler}} success={{success}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reconciles/sec. success=false includes benign requeues (running PipelineRuns re-queue constantly) \u2014 watch the trend, not the absolute value."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Controller workqueue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (label_replace(tekton_pipelines_controller_workqueue_depth, \"name\", \"$1\", \"name\", \".*\\\\.([^.]+\\\\.Reconciler.*)\"))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Items waiting for reconcile. Sustained growth = controller saturation."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Results API gRPC errors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grpc_code, grpc_method) (rate(grpc_server_handled_total{grpc_code!~\"OK|NotFound\"}[$__rate_interval])) > 0",
          "legendFormat": "{{grpc_method}} {{grpc_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Non-OK responses from the Results API, excluding benign NotFound (Portal polls runs before archival). Empty panel = healthy."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Results watcher: PipelineRuns pruned per interval",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (status)(increase(watcher_pipelinerun_delete_count_total[$__interval])))",
          "legendFormat": "{{status}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Completed runs archived to Results and deleted from the cluster. status=failed here means the DELETE failed \u2014 runs pile up."
    }
  ]
}